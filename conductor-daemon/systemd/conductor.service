[Unit]
Description=Conductor MIDI Controller Mapping Daemon
Documentation=man:conductor(1) https://github.com/monstrous-media/conductor
After=network.target sound.target

# Restart if daemon crashes
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/conductor
ExecReload=/usr/local/bin/conductorctl reload
ExecStop=/usr/local/bin/conductorctl stop

# Restart policy
Restart=on-failure
RestartSec=5s

# Process priority
Nice=-5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=conductor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# #1314: %h/.conductor is where StateManager::get_state_dir() writes
# on Linux (see conductor-daemon/src/daemon/state.rs::get_state_dir).
# Without this entry, hardened startup fails at the first state
# write because ProtectHome=read-only blocks all home-directory
# writes outside ReadWritePaths. A future cleanup will migrate
# get_state_dir() to %h/.local/state/conductor (XDG, matches
# LivePaths) and remove %h/.conductor here.
ReadWritePaths=%h/.conductor %h/.config/conductor %h/.local/state/conductor %h/.local/share/conductor

# Resource limits
LimitNOFILE=1024
LimitNPROC=64

# Environment
Environment="RUST_LOG=conductor=info"

[Install]
WantedBy=default.target
